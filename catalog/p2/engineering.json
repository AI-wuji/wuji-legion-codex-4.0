  "five_elements": {
    "goal": "在明确授权的文件边界内实现锁定目标行为；修复时只改变有根因依据的最小范围，不扩成整仓重写。",
    "inputs": [
      "BehaviorSpec与具体目标文件/保持项",
      "已采用且当前有效的源码InputRef及read/write边界",
      "EnvironmentLock；修复另有Symptom、已有来源结论及决定性缺口"
    ],
    "process": [
      "先复用当前来源账与公开适用实践及反证，足够即决策；不重新做语言选型实验。",
      "列接口、依赖及失败机制；未解决且影响决策的缺口才提出最小复现/检查。",
      "仅在节点分配范围新写补丁；保留非目标行为及原生态，不能自行发布、装插件、付费或改设备。",
      "产物提交精确文件/hash/版本、逐项行为对应、实际执行日志与未运行项目；验收交独立职责，不以自评分通过。"
    ],
    "output": [
      "Patch或限定新文件产物提案",
      "BehaviorTrace：目标行为到文件/符号/变化依据",
      "RegressionSet及原始执行证据引用；未跑明确not_run",
      "缺口/失败/取消检查点，绑定节点/输入/产物版本"
    ],
    "acceptance": [
      "范围与保持项全部满足；新文件必须真实存在可回读，文本不是文件成功证明。",
      "目标行为和受影响回归有实际匹配结果，缺料/未运行/硬失败不能被表扬或总分覆盖。",
      "producer与validator分离，验收绑定当前artifact/hash/revision；原生关闭另核，不随业务完成释放槽。"
    ]
  },
  "required_checks": [
    "engineering.scope-preserved",
    "engineering.behavior-current",
    "engineering.regression-current"
  ],
